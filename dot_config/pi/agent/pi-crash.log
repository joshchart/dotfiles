[306] (w=67) [48;2;41;46;66m                                                                   [49m[0m]8;;
[307] (w=67) [48;2;41;46;66m [38;2;255;158;100m[1m[4mSessionizer[24m[22m[39m                                                       [49m[0m]8;;
