[760] (w=67)    tmux select-window -t [38;2;158;206;106m"[38;2;255;158;100m${session}[39m:[38;2;255;158;100m${window}[39m"[39m                    [0m]8;;
[761] (w=67)    tmux select-pane -t [38;2;158;206;106m"[38;2;255;158;100m$pane_id[39m"[39m                                  [0m]8;;
[762] (w=67)  [38;2;59;66;97m```[39m                                                               [0m]8;;
[763] (w=67)                                                                    [0m]8;;
[764] (w=67)  Make it executable:                                               [0m]8;;
[765] (w=67)                                                                    [0m]8;;
[766] (w=67)  [38;2;59;66;97m```bash[39m                                                           [0m]8;;
[767] (w=67)    chmod +x ~/.config/tmux/scripts/agents                          [0m]8;;
[768] (w=67)  [38;2;59;66;97m```[39m                                                               [0m]8;;
[769] (w=67)                                                                    [0m]8;;
[770] (w=67)  Then bind it in tmux:                                             [0m]8;;
[771] (w=67)                                                                    [0m]8;;
[772] (w=67)  [38;2;59;66;97m```tmux[39m                                                           [0m]8;;
