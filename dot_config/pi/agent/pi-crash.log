[1157] (w=67)  [38;2;255;158;100m[1mCore idea[22m[39m                                                         [0m]8;;
[1158] (w=67)                                                                    [0m]8;;
[1159] (w=67)  If your list includes the pane id, like [38;2;158;206;106m%12[39m, then [38;2;158;206;106mfzf[39m can preview [0m]8;;
[1160] (w=67)  it with:                                                          [0m]8;;
[1161] (w=67)                                                                    [0m]8;;
[1162] (w=67)  [38;2;59;66;97m```bash[39m                                                           [0m]8;;
[1163] (w=67)    tmux capture-pane -p -t %12 -S -200                             [0m]8;;
[1164] (w=67)  [38;2;59;66;97m```[39m                                                               [0m]8;;
[1165] (w=67)                                                                    [0m]8;;
[1166] (w=67)  That prints the pane contents.                                    [0m]8;;
[1167] (w=67)                                                                    [0m]8;;
[1168] (w=67)  Inside [38;2;158;206;106mfzf[39m, the preview command would just pull the pane id from  [0m]8;;
[1169] (w=67)  the selected row.                                                 [0m]8;;
[1170] (w=67)                                                                    [0m]8;;
[1171] (w=67)  [38;2;59;66;97m─────────────────────────────────────────────────────────────────[39m [0m]8;;
[1172] (w=67)                                                                    [0m]8;;
[1173] (w=67)  [38;2;255;158;100m[1mExample shape[22m[39m                                                     [0m]8;;
[1174] (w=67)                                                                    [0m]8;;
[1175] (w=67)  If your input rows are tab-separated like:                        [0m]8;;
[1176] (w=67)                                                                    [0m]8;;
[1177] (w=67)  [38;2;59;66;97m```text[39m                                                           [0m]8;;
[1178] (w=67)    work    2    1    %12    pi    herdr    /Users/josh/work/herdr  [0m]8;;
[1179] (w=67)  [38;2;59;66;97m```[39m                                                               [0m]8;;
[1180] (w=67)                                                                    [0m]8;;
[1181] (w=67)  then [38;2;158;206;106mfzf[39m can do:                                                  [0m]8;;
[1182] (w=67)                                                                    [0m]8;;
[1183] (w=67)  [38;2;59;66;97m```bash[39m                                                           [0m]8;;
[1184] (w=67)    fzf --delimiter=$[38;2;158;206;106m'\t'[39m \                                         [0m]8;;
[1185] (w=67)        --with-nth=1,2,3,5,6,7 \                                    [0m]8;;
[1186] (w=67)        --preview [38;2;158;206;106m'tmux capture-pane -p -t {4} -S -200'[39m \           [0m]8;;
[1187] (w=67)        --preview-window=right,70%,wrap                             [0m]8;;
[1188] (w=67)  [38;2;59;66;97m```[39m                                                               [0m]8;;
