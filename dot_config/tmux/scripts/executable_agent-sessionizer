#!/usr/bin/env bash
set -euo pipefail

self_path=${BASH_SOURCE[0]}

trim() {
  local value=$1
  value=${value#${value%%[![:space:]]*}}
  value=${value%${value##*[![:space:]]}}
  printf '%s' "$value"
}

popup_width() {
  local width
  width=$(tmux display-message -p '#{popup_width}' 2>/dev/null || true)
  if [[ -z "$width" || ! "$width" =~ ^[0-9]+$ ]]; then
    width=${COLUMNS:-80}
  fi
  printf '%s' "$width"
}

truncate_title() {
  local loc=$1
  local title=$2
  local width list_width title_width

  width=$(popup_width)
  list_width=$(( width * 55 / 100 ))
  title_width=$(( list_width - ${#loc} - 2 ))

  if (( title_width < 8 )); then
    printf '%s' "$title"
    return
  fi

  if (( ${#title} > title_width )); then
    printf '%s…' "${title:0:title_width-1}"
  else
    printf '%s' "$title"
  fi
}

preview_pane() {
  local pane_id=$1

  if ! tmux display-message -p -t "$pane_id" '#{pane_id}' >/dev/null 2>&1; then
    printf 'Pane %s is no longer available.\n' "$pane_id"
    return
  fi

  tmux capture-pane -ep -t "$pane_id" -S -200 2>/dev/null || printf 'Unable to capture pane %s.\n' "$pane_id"
}

list_pi_panes() {
  tmux list-panes -a -F '#{session_name}	#{window_index}	#{pane_index}	#{pane_id}	#{pane_tty}	#{pane_current_command}	#{window_activity}	#{pane_active}	#{pane_last}' |
    while IFS=$'\t' read -r session_name window_index pane_index pane_id pane_tty pane_command window_activity pane_active pane_last; do
      [[ $pane_command == node ]] || continue

      short_tty=${pane_tty#/dev/}
      if ! ps -t "$short_tty" -o args= | grep -E '(^|[ /])pi([ ]|$)' >/dev/null; then
        continue
      fi

      pane_title=$(tmux display-message -p -t "$pane_id" '#{pane_title}' 2>/dev/null || true)
      pane_title=${pane_title//$'\t'/ }
      pane_title=$(trim "$pane_title")
      [[ -n $pane_title ]] || pane_title='pi'

      location="${session_name}:${window_index}.${pane_index}"
      display_title=$(truncate_title "$location" "$pane_title")

      printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
        "${window_activity:-0}" \
        "${pane_active:-0}" \
        "${pane_last:-0}" \
        "$pane_id" \
        "$session_name" \
        "$window_index" \
        "$pane_index" \
        "$location" \
        "$display_title"
    done |
    sort -t $'\t' -k1,1nr -k2,2nr -k3,3nr -k8,8
}

show_empty_state() {
  clear
  printf '\nNo active agents\n\n'
  printf 'Press q or Esc to close.\n'

  while IFS= read -rsn1 key; do
    case "$key" in
      q|$'\e')
        exit 0
        ;;
    esac
  done
}

jump_to_selection() {
  local selection=$1
  local pane_id session_name window_index

  IFS=$'\t' read -r _ _ _ pane_id session_name window_index _ _ _ <<< "$selection"

  tmux switch-client -t "$session_name"
  tmux select-window -t "${session_name}:${window_index}"
  tmux select-pane -t "$pane_id"
}

run_picker() {
  local data selection self_quoted preview_cmd

  data=$(list_pi_panes)
  if [[ -z $data ]]; then
    show_empty_state
  fi

  self_quoted=$(printf '%q' "$self_path")
  preview_cmd="${self_quoted} --preview {4}"

  selection=$(printf '%s\n' "$data" | \
    env -u FZF_DEFAULT_OPTS -u FZF_DEFAULT_OPTS_FILE -u FZF_DEFAULT_COMMAND fzf \
      --delimiter=$'\t' \
      --with-nth=8,9 \
      --preview "$preview_cmd" \
      --preview-window='right,45%,wrap' \
      --prompt='Pi > ' \
      --header=$'session:window.pane  title' \
      --bind='esc:abort') || true

  [[ -n $selection ]] || exit 0
  jump_to_selection "$selection"
}

case "${1:-}" in
  --list)
    list_pi_panes
    ;;
  --preview)
    preview_pane "$2"
    ;;
  '')
    run_picker
    ;;
  *)
    printf 'Usage: %s [--list | --preview <pane-id>]\n' "$0" >&2
    exit 1
    ;;
esac
