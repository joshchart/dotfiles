#!/usr/bin/env bash
set -euo pipefail

self_path=${BASH_SOURCE[0]}
state_option='@pi_agent_state'
completion_option='@pi_agent_completion_id'
seen_completion_option='@pi_agent_seen_completion_id'
last_visited_option='@pi_agent_last_visited'
last_visited_tick_option='@pi_agent_last_visited_tick'
visible_panes_cache=''
pi_tty_cache=''
pi_tty_cache_loaded=0
popup_width_cache=''
color_status_mode=${AGENT_SESSIONIZER_COLOR:-0}

trim() {
  local value=$1
  value=${value#${value%%[![:space:]]*}}
  value=${value%${value##*[![:space:]]}}
  printf '%s' "$value"
}

popup_width() {
  local width

  if [[ -n $popup_width_cache ]]; then
    printf '%s' "$popup_width_cache"
    return
  fi

  width=$(tmux display-message -p '#{popup_width}' 2>/dev/null || true)
  if [[ -z $width || ! $width =~ ^[0-9]+$ ]]; then
    width=$(tmux display-message -p '#{client_width}' 2>/dev/null || true)
  fi
  if [[ -z $width || ! $width =~ ^[0-9]+$ ]]; then
    width=$(tmux display-message -p '#{pane_width}' 2>/dev/null || true)
  fi
  if [[ -z $width || ! $width =~ ^[0-9]+$ ]]; then
    width=${COLUMNS:-80}
  fi

  popup_width_cache=$width
  printf '%s' "$width"
}

tmux_pane_option() {
  local pane_id=$1
  local option=$2

  tmux show-options -p -v -t "$pane_id" "$option" 2>/dev/null || true
}

set_tmux_pane_option() {
  local pane_id=$1
  local option=$2
  local value=${3-}

  if [[ -n $value ]]; then
    tmux set-option -p -t "$pane_id" "$option" "$value" >/dev/null 2>&1 || true
  else
    tmux set-option -p -u -t "$pane_id" "$option" >/dev/null 2>&1 || true
  fi
}

capture_plain_pane() {
  local pane_id=$1

  tmux capture-pane -p -t "$pane_id" -S -120 2>/dev/null || true
}

preview_line_count() {
  local pane_id=$1

  tmux capture-pane -p -t "$pane_id" -S -200 2>/dev/null | awk 'END { print NR + 0 }'
}

current_client_panes() {
  local window_id context_pane context_window_id

  {
    tmux list-clients -F '#{window_id}' 2>/dev/null || true

    context_pane=${TMUX_PANE-}
    if [[ -n $context_pane ]]; then
      context_window_id=$(tmux display-message -p -t "$context_pane" '#{window_id}' 2>/dev/null || true)
      [[ -n $context_window_id ]] && printf '%s\n' "$context_window_id"
    fi
  } | awk 'NF' | sort -u | while IFS= read -r window_id; do
    [[ -n $window_id ]] || continue
    tmux list-panes -t "$window_id" -F '#{pane_id}' 2>/dev/null || true
  done | awk 'NF' | sort -u
}

refresh_visible_panes_cache() {
  visible_panes_cache=$(current_client_panes || true)
}

refresh_pi_tty_cache() {
  pi_tty_cache=$(ps -Ao tty=,args= | awk '
    {
      tty = $1
      $1 = ""
      sub(/^[[:space:]]+/, "", $0)
      if ($0 ~ /(^|[[:space:]\/])pi([[:space:]]|$)/) {
        print tty
      }
    }
  ' | sort -u)
  pi_tty_cache_loaded=1
}

ensure_pi_tty_cache() {
  (( pi_tty_cache_loaded == 1 )) || refresh_pi_tty_cache
}

tty_has_pi() {
  local short_tty=$1

  [[ -n $pi_tty_cache ]] && grep -Fxq "$short_tty" <<< "$pi_tty_cache"
}

pane_is_visible() {
  local pane_id=$1

  [[ -n $visible_panes_cache ]] && grep -Fxq "$pane_id" <<< "$visible_panes_cache"
}

current_visit_tick() {
  local now previous

  now=$(date +%s)
  if [[ -z ${now:-} || ! $now =~ ^[0-9]+$ ]]; then
    now=0
  fi

  previous=$(tmux show-options -g -v "$last_visited_tick_option" 2>/dev/null || true)
  if [[ $previous =~ ^[0-9]+$ ]] && (( now <= previous )); then
    now=$(( previous + 1 ))
  fi

  tmux set-option -gq "$last_visited_tick_option" "$now" >/dev/null 2>&1 || true
  printf '%s' "$now"
}

mark_pane_seen() {
  local pane_id=$1
  local completion_id now

  if ! tmux display-message -p -t "$pane_id" '#{pane_id}' >/dev/null 2>&1; then
    return 0
  fi

  now=$(current_visit_tick)
  set_tmux_pane_option "$pane_id" "$last_visited_option" "$now"

  completion_id=$(tmux_pane_option "$pane_id" "$completion_option")
  [[ -n $completion_id ]] && set_tmux_pane_option "$pane_id" "$seen_completion_option" "$completion_id"
  return 0
}

mark_visible_panes_seen() {
  local pane_id

  refresh_visible_panes_cache
  while IFS= read -r pane_id; do
    [[ -n $pane_id ]] || continue
    mark_pane_seen "$pane_id"
  done <<< "$visible_panes_cache"
}

sync_visible_completion_seen() {
  local pane_id=$1
  local completion_id=$2
  local seen_completion_id=$3

  if [[ -n $completion_id && $completion_id != "$seen_completion_id" ]] && pane_is_visible "$pane_id"; then
    set_tmux_pane_option "$pane_id" "$seen_completion_option" "$completion_id"
  fi
}

normalize_meaningful_tail() {
  awk '
    function trim(s) {
      sub(/^[[:space:]]+/, "", s)
      sub(/[[:space:]]+$/, "", s)
      return s
    }
    {
      line = trim($0)
      if (line == "") next
      if (line ~ /^[-=~_[:space:]]{8,}$/) next
      if (index(line, "────") > 0 || index(line, "──────") > 0) next
      if (line ~ /[[:space:]](INSERT|NORMAL)$/) next
      if (line ~ /^~\//) next
      if (line ~ /gpt-[0-9]/) next
      if (line ~ /^(Elapsed|Took) [0-9.]+s$/) next
      print line
    }
  ' | tail -n 8
}

heuristic_raw_state_from_content() {
  local content=$1
  local normalized_tail

  if [[ -z $content ]]; then
    printf 'unknown'
    return
  fi

  if printf '%s\n' "$content" | grep -Eq '(^|[[:space:]])Working\.\.\.$'; then
    printf 'working'
    return
  fi

  normalized_tail=$(printf '%s\n' "$content" | normalize_meaningful_tail | tr '\n' ' ')
  normalized_tail=$(trim "$normalized_tail")

  if [[ -n $normalized_tail ]] && printf '%s\n' "$normalized_tail" | grep -Eiq '(\?[[:space:]]*$|\bdo you want me\b|\bwould you like me\b|\bshould i\b|\bcan i\b|\bwhat would you like\b|\bhow would you like\b|\bwhich (one|option|approach|path|version)\b|\bplease (provide|confirm|approve|share|pick|choose|select|send)\b|\b(approval|input) (is )?required\b|\bwaiting for (input|approval|confirmation)\b|\blet me know\b)'; then
    printf 'blocked'
    return
  fi

  if printf '%s\n' "$content" | grep -Eq '(^|[[:space:]])(INSERT|NORMAL)$|gpt-[0-9]|^~/' ; then
    printf 'idle'
    return
  fi

  printf 'unknown'
}

raw_state_for_pane() {
  local metadata_state=$1
  local pane_id=$2
  local content=${3-}

  case "$metadata_state" in
    working|blocked|idle|unknown)
      printf '%s' "$metadata_state"
      ;;
    *)
      if [[ -z ${content:-} ]]; then
        content=$(capture_plain_pane "$pane_id")
      fi
      heuristic_raw_state_from_content "$content"
      ;;
  esac
}

effective_state_for_pane() {
  local pane_id=$1
  local metadata_state=$2
  local completion_id=$3
  local seen_completion_id=$4
  local content=${5-}
  local raw_state

  raw_state=$(raw_state_for_pane "$metadata_state" "$pane_id" "$content")
  if [[ $raw_state != idle ]]; then
    printf '%s' "$raw_state"
    return
  fi

  if pane_is_visible "$pane_id"; then
    printf 'idle'
    return
  fi

  if [[ -n $completion_id && $completion_id != "$seen_completion_id" ]]; then
    printf 'done'
    return
  fi

  printf 'idle'
}

status_long_label() {
  case "$1" in
    working) printf 'working' ;;
    blocked) printf 'blocked' ;;
    idle) printf 'idle' ;;
    done) printf 'done' ;;
    *) printf 'unknown' ;;
  esac
}

status_short_label() {
  case "$1" in
    working) printf 'w' ;;
    blocked) printf 'b' ;;
    idle) printf 'i' ;;
    done) printf 'd' ;;
    *) printf 'u' ;;
  esac
}

status_color_code() {
  case "$1" in
    working) printf '\033[38;5;214m' ;;
    blocked) printf '\033[38;5;203m' ;;
    idle) printf '\033[38;5;244m' ;;
    done) printf '\033[38;5;114m' ;;
    *) printf '\033[38;5;240m' ;;
  esac
}

colorize_status_label() {
  local state=$1
  local label=$2

  if [[ $color_status_mode != 1 ]]; then
    printf '%s' "$label"
    return
  fi

  printf '%b%s%b' "$(status_color_code "$state")" "$label" $'\033[0m'
}

pad_right() {
  local text=$1
  local width=$2

  if (( ${#text} >= width )); then
    printf '%s' "$text"
    return
  fi

  printf '%s%*s' "$text" "$(( width - ${#text} ))" ''
}

truncate_text() {
  local text=$1
  local max_width=$2

  if (( max_width < 8 )) || (( ${#text} <= max_width )); then
    printf '%s' "$text"
    return
  fi

  printf '%s…' "${text:0:max_width-1}"
}

format_status_and_title() {
  local location=$1
  local state=$2
  local title=$3
  local location_width=$4
  local width list_width status_width status_label colored_status title_width

  width=$(popup_width)
  list_width=$(( width * 55 / 100 ))

  status_width=7
  title_width=$(( list_width - location_width - status_width - 4 ))
  if (( title_width < 14 )); then
    status_width=1
    title_width=$(( list_width - location_width - status_width - 4 ))
  fi

  status_label=$(status_long_label "$state")
  if (( status_width == 1 )); then
    status_label=$(status_short_label "$state")
  fi

  colored_status=$(colorize_status_label "$state" "$(pad_right "$status_label" "$status_width")")
  printf '%s\t%s' "$(pad_right "$location" "$location_width")" "$colored_status"
  printf '\t%s' "$(truncate_text "$title" "$title_width")"
}

preview_pane() {
  local pane_id=$1

  if ! tmux display-message -p -t "$pane_id" '#{pane_id}' >/dev/null 2>&1; then
    printf 'Pane %s is no longer available.\n' "$pane_id"
    return
  fi

  tmux capture-pane -ep -t "$pane_id" -S -200 2>/dev/null || printf 'Unable to capture pane %s.\n' "$pane_id"
}

list_pi_panes() {
  local short_tty pane_title location content preview_lines agent_marker metadata_state completion_id seen_completion_id last_visited state status_and_title max_location_width display_location display_status display_title current_pane is_current
  local row
  local -a rows=()

  max_location_width=0
  refresh_visible_panes_cache
  current_pane=$(tmux display-message -p '#{pane_id}' 2>/dev/null || true)

  while IFS=$'\t' read -r session_name window_index pane_index pane_id pane_tty pane_command window_activity pane_active pane_last pane_title agent_marker metadata_state completion_id seen_completion_id last_visited; do
    [[ $pane_command == node ]] || continue

    if [[ $agent_marker != 1 ]]; then
      short_tty=${pane_tty#/dev/}
      ensure_pi_tty_cache
      if ! tty_has_pi "$short_tty"; then
        continue
      fi
    fi

    pane_title=${pane_title//$'\t'/ }
    pane_title=$(trim "$pane_title")
    [[ -n $pane_title ]] || pane_title='pi'

    location="${session_name}:${window_index}.${pane_index}"
    if (( ${#location} > max_location_width )); then
      max_location_width=${#location}
    fi

    content=''
    if [[ ! $metadata_state =~ ^(working|blocked|idle|unknown)$ ]]; then
      content=$(capture_plain_pane "$pane_id")
    fi

    sync_visible_completion_seen "$pane_id" "$completion_id" "$seen_completion_id"
    if [[ -n $completion_id ]] && pane_is_visible "$pane_id"; then
      seen_completion_id=$completion_id
    fi

    state=$(effective_state_for_pane "$pane_id" "$metadata_state" "$completion_id" "$seen_completion_id" "$content")
    preview_lines=$(preview_line_count "$pane_id")
    if [[ $pane_id == "$current_pane" ]]; then
      is_current=1
    else
      is_current=0
    fi
    rows+=("${is_current:-0}"$'\t'"${last_visited:-0}"$'\t'"${window_activity:-0}"$'\t'"${pane_active:-0}"$'\t'"${pane_last:-0}"$'\t'"$pane_id"$'\t'"$session_name"$'\t'"$window_index"$'\t'"$pane_index"$'\t'"$location"$'\t'"$state"$'\t'"$pane_title"$'\t'"${preview_lines:-0}")
  done < <(
    tmux list-panes -a -F '#{session_name}	#{window_index}	#{pane_index}	#{pane_id}	#{pane_tty}	#{pane_current_command}	#{window_activity}	#{pane_active}	#{pane_last}	#{pane_title}	#{@pi_agent}	#{@pi_agent_state}	#{@pi_agent_completion_id}	#{@pi_agent_seen_completion_id}	#{@pi_agent_last_visited}'
  )

  (( ${#rows[@]} == 0 )) && return 0

  while IFS= read -r row; do
    IFS=$'\t' read -r is_current last_visited window_activity pane_active pane_last pane_id session_name window_index pane_index location state pane_title preview_lines <<< "$row"
    status_and_title=$(format_status_and_title "$location" "$state" "$pane_title" "$max_location_width")
    IFS=$'\t' read -r display_location display_status display_title <<< "$status_and_title"

    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
      "$window_activity" \
      "$pane_active" \
      "$pane_last" \
      "$pane_id" \
      "$session_name" \
      "$window_index" \
      "$pane_index" \
      "$display_location" \
      "$display_status" \
      "$display_title" \
      "$preview_lines"
  done < <(
    printf '%s\n' "${rows[@]}" | sort -t $'\t' -k1,1n -k2,2nr -k3,3nr -k4,4nr -k5,5nr -k7,7 -k8,8nr -k9,9nr
  )
}

show_empty_state() {
  clear
  printf '\nNo active agents\n\n'
  printf 'Press q or Esc to close.\n'

  while IFS= read -rsn1 key; do
    case "$key" in
      q|$'\e')
        exit 0
        ;;
    esac
  done
}

jump_to_selection() {
  local selection=$1
  local pane_id session_name window_index current_session current_window current_pane self_quoted pane_quoted

  IFS=$'\t' read -r _ _ _ pane_id session_name window_index _ _ _ _ <<< "$selection"

  current_session=$(tmux display-message -p '#{session_name}' 2>/dev/null || true)
  if [[ $current_session != "$session_name" ]]; then
    tmux switch-client -t "$session_name"
  fi

  current_window=$(tmux display-message -p '#{window_index}' 2>/dev/null || true)
  if [[ $current_window != "$window_index" ]]; then
    tmux select-window -t "${session_name}:${window_index}"
  fi

  current_pane=$(tmux display-message -p '#{pane_id}' 2>/dev/null || true)
  if [[ $current_pane != "$pane_id" ]]; then
    tmux select-pane -t "$pane_id"
  fi

  self_quoted=$(printf '%q' "$self_path")
  pane_quoted=$(printf '%q' "$pane_id")
  tmux run-shell -b "${self_quoted} --mark-seen ${pane_quoted}" >/dev/null 2>&1 || true
}

run_picker() {
  local data selection self_quoted preview_cmd

  color_status_mode=1
  data=$(list_pi_panes)
  if [[ -z $data ]]; then
    show_empty_state
  fi

  self_quoted=$(printf '%q' "$self_path")
  preview_cmd="${self_quoted} --preview {4}"

  selection=$(printf '%s\n' "$data" | \
    env -u FZF_DEFAULT_OPTS -u FZF_DEFAULT_OPTS_FILE -u FZF_DEFAULT_COMMAND fzf \
      --ansi \
      --delimiter=$'\t' \
      --tabstop=1 \
      --with-nth=8,9,10 \
      --nth=1,3 \
      --preview "$preview_cmd" \
      --preview-window='right,45%,wrap,+{11}-25' \
      --prompt='Pi > ' \
      --header=$'session:window.pane   status    title' \
      --cycle \
      --bind='esc:abort') || true

  [[ -n $selection ]] || exit 0
  jump_to_selection "$selection"
}

case "${1:-}" in
  --list)
    list_pi_panes
    ;;
  --preview)
    preview_pane "$2"
    ;;
  --mark-seen-current)
    mark_visible_panes_seen
    ;;
  --mark-seen)
    mark_pane_seen "$2"
    ;;
  '')
    run_picker
    ;;
  *)
    printf 'Usage: %s [--list | --preview <pane-id> | --mark-seen-current | --mark-seen <pane-id>]\n' "$0" >&2
    exit 1
    ;;
esac
